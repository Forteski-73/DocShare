# Banco de dados (MySQL via XAMPP)
DATABASE_URL="mysql://root:@127.0.0.1:3306/docshare"

# Servidor
PORT=3333
NODE_ENV=development

# Frontend (para CORS e links nos e-mails)
FRONTEND_URL="http://localhost:5173"

# JWT (cookie httpOnly)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="docshare_token"

# Tokens de convite / redefinicao de senha
INVITE_TOKEN_EXPIRES_HOURS=48
RESET_TOKEN_EXPIRES_HOURS=1

# Upload
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=20

# SMTP (dev: Ethereal - deixe em branco para gerar conta de teste automaticamente)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DocShare <no-reply@docshare.local>"

# Cloudflare Turnstile (protecao contra login por forca bruta/bots na tela de login)
# Chave de teste publica abaixo sempre passa - use so em dev.
# Em producao, crie um site em https://dash.cloudflare.com/?to=/:account/turnstile
# e substitua pela SECRET KEY real (a SITE KEY publica fica no frontend/.env).
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
